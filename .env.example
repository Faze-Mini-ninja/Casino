# Copy to .env and edit. Every value has a safe devnet default.

# --- Network -------------------------------------------------------------
# devnet/testnet = every coin on its test network (Solana devnet, Ethereum Sepolia, Litecoin testnet).
# mainnet-beta = every coin on mainnet.
SOLANA_CLUSTER=devnet
# RPC_URL=https://api.devnet.solana.com          # Solana RPC; use a paid one (Helius, Triton, QuickNode…) in production
# ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com   # Ethereum JSON-RPC (Alchemy, Infura…) in production
# LTC_API_URL=https://litecoinspace.org/testnet/api          # Esplora-compatible Litecoin API
# COINS=SOL,USDC,ETH,LTC                         # which coins to offer
# ETH_CONFIRMATIONS=12
# LTC_CONFIRMATIONS=3

# --- Keys ----------------------------------------------------------------
# Master seed: every daily deposit wallet AND every hot wallet are derived from it
# (SOL/USDC m/44'/501'/i'/0', ETH m/44'/60'/0'/0/i, LTC m/84'/2'/0'/0/i; index 0 = hot wallet).
# 128 hex characters (npm run gen-seed) or any random string of 32+ characters (e.g. Render's "Generate").
# On devnet one is generated in data/ if unset. On mainnet you MUST set it.
# Back it up offline. Anyone with this seed controls all deposit wallets and hot wallets. Never change it later.
# MASTER_SEED=

# Cold treasuries (public addresses only; their private keys never touch this server).
# Each coin's hot wallet is kept at about HOT_FLOAT_USD; sweeps above that go to the treasury. Empty = keep in hot wallet.
# TREASURY_ADDRESS=        # Solana wallet, receives SOL and USDC
# TREASURY_ETH=
# TREASURY_LTC=
HOT_FLOAT_USD=1000

# --- Money rules (balances are dollars: 1 credit = $1) -------------------
# MIN_DEPOSIT_SOL=0.01  MIN_DEPOSIT_USDC=1  MIN_DEPOSIT_ETH=0.002  MIN_DEPOSIT_LTC=0.01
# WITHDRAW_FEE_SOL=0.000005  WITHDRAW_FEE_USDC=0.5  WITHDRAW_FEE_ETH=0.0005  WITHDRAW_FEE_LTC=0.0002   # charged in the coin
MIN_WITHDRAW_USD=5
DEPOSIT_FEE_PCT=1                # % of each deposit's dollar value kept as a fee (0 = none); shown to players before they deposit
AUTO_APPROVE_USD=100             # withdrawals up to this are sent automatically…
AUTO_APPROVE_DAILY_USD=500       # …until a player's 24h total passes this; the rest wait for admin approval
MAX_BET_CREDITS=10000
# DEMO_START_CREDITS=1000       # free demo credits for new accounts (top-up back to this below 10%)
ADDRESS_WATCH_DAYS=30            # keep crediting deposits to a player's older daily addresses for this long

# --- Server --------------------------------------------------------------
PORT=8080
# TRUST_PROXY=true               # behind nginx/Cloudflare, so rate limits see the real client IP
# COOKIE_SECURE=true             # required when served over HTTPS (default on for mainnet)
# CHAIN_ENABLED=false            # run demo-only with no blockchain access

# PROXY_HOPS=1                   # with TRUST_PROXY: how many proxies sit in front (Cloudflare + Railway = 2)

# Mainnet refuses to start unless you set this, and you should only set it once you hold a gambling
# licence (or legal sign-off) for every jurisdiction you accept players from, with KYC/AML and geo-blocking in place.
# REAL_MONEY_ACKNOWLEDGED=yes

# --- Compliance ----------------------------------------------------------
# Shown in the site footer. Anjouan licensees must display the licence details (and the regulator's seal if issued).
# LICENSE_TEXT=krush.casino is operated by <Company Ltd>, licensed by the Anjouan Offshore Finance Authority, licence no. <number>.

# Responsible gambling: raising or removing a deposit limit waits this long.
# RG_INCREASE_DELAY_HOURS=24

# AML review flags. A player with an open flag has every withdrawal held for approval.
# AML_DEPOSIT_FLAG_USD=2000      # any single deposit this large
# AML_DAILY_FLAG_USD=5000        # deposits in 24 h reaching this
# AML_MIN_TURNOVER=1             # withdrawing before wagering this × the last week's deposits (0 = off)

# --- Multiplayer -----------------------------------------------------------
# PvP Arena: the house keeps this % of the pot; the winner gets the rest. Ties are refunded in full.
# PVP_RAKE_PCT=5
# PVP_MOVE_SECS=30               # blackjack duel: time per move before an automatic stand
# BJT_BET_SECS=12                # live blackjack: betting closes this long after the first bet
# BJT_TURN_SECS=20               # live blackjack: time per turn before an automatic stand

# --- Backups (see DEPLOY.md) ----------------------------------------------
# An encrypted snapshot of the database every BACKUP_INTERVAL_MIN minutes, kept in DATA_DIR/backups and, with
# BACKUP_S3_* set, uploaded to S3-compatible storage (Backblaze B2, Cloudflare R2…). Encrypted with BACKUP_KEY, or
# a key derived from MASTER_SEED if empty. Restore: node tools/restore-backup.js <file> <out.db>
# BACKUP_INTERVAL_MIN=60          # 0 = off
# BACKUP_KEEP_LOCAL=48
# BACKUP_KEY=
# BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# BACKUP_S3_REGION=us-west-004    # "auto" for Cloudflare R2
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=
# BACKUP_S3_KEY_ID=
# BACKUP_S3_SECRET=

# --- Accounts ------------------------------------------------------------
# Your admin login. Created (or its password reset) at every startup. When set, newly registered
# accounts are always ordinary players; without it, the first account registered becomes admin.
# ADMIN_USERNAME=owner
# ADMIN_PASSWORD=use-a-long-unique-password

# --- Display -------------------------------------------------------------
# Odds are hidden from players by default (no house edges, RTPs or win probabilities; payouts still shown).
# Some licences require RTP to be published. Set true to show everything.
# SHOW_ODDS=false

# --- Referrals -----------------------------------------------------------
# Referrers earn this share of the house's theoretical profit (stake × house edge) on every real-money bet
# their referred players make. Capped at 0.5. Set 0 to turn commissions off.
# REFERRAL_SHARE=0.10

# --- Private testing -----------------------------------------------------
# Require this code to create an account (share it with your testers). Leave empty for open sign-up.
# REGISTRATION_CODE=

# Accounts created on first start if they don't exist (username:password:demoCredits:realCredits, comma-separated).
# SEED_USERS=Brandon:changeme123:10000:10000
